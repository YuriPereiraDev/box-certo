// Box Certo — schema do banco (Prisma 7).
// A URL de conexão fica em prisma.config.ts; o cliente usa o driver adapter do PostgreSQL.
// Fase 0: apenas admin da plataforma e planos. Os demais modelos entram nas fases seguintes.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum PermissaoPlataforma {
  FINANCEIRO
  GESTAO_OFICINAS
  GESTAO_USUARIOS
  SUPORTE
  GESTAO_ADMINS
}

model Plano {
  id            String   @id @default(uuid())
  nome          String   @unique // Autônomo, Oficina, Rede
  precoCentavos Int
  maxMecanicos  Int? // null = ilimitado
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PlatformAdmin {
  id         String                @id @default(uuid())
  nome       String
  email      String                @unique
  senhaHash  String
  isOwner    Boolean               @default(false)
  permissoes PermissaoPlataforma[]
  totpSecret String?
  ativo      Boolean               @default(true)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
}
