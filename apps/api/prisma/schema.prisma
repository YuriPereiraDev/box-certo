// Box Certo — schema do banco (Prisma 7).
// A URL de conexão fica em prisma.config.ts; o cliente usa o driver adapter do PostgreSQL.
// Fase 1: oficina, usuários, clientes, refresh tokens e auditoria.
// Fase 2: horários, convites, tabela de preços e veículos.
// Fase 3: agendamentos.
// Fase 4: ordens de serviço, orçamento, descontos e arquivos.
// Fase 5: estoque (e o mínimo de despesas para a despesa automática da entrada).
// Fase 6: despesas completas (recorrentes, salários, comprovantes).
// Fase 8: plataforma (avisos, modo suporte, histórico de status da oficina).
// Fase 9: tickets de suporte.
// Os demais modelos entram nas fases seguintes.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum OficinaStatus {
  TESTE
  ATIVA
  SUSPENSA
  CANCELADA
}

enum UserRole {
  MASTER
  MECANICO
  FINANCEIRO
}

enum PermissaoOficina {
  GERENTE
  FINANCEIRO
  VER_SALARIOS
  GERIR_ESTOQUE
  VER_LOGS
}

enum PermissaoPlataforma {
  FINANCEIRO
  GESTAO_OFICINAS
  GESTAO_USUARIOS
  SUPORTE
  GESTAO_ADMINS
}

enum TipoItem {
  PECA
  MAO_DE_OBRA
}

enum StatusAgendamento {
  AGENDADO
  CONFIRMADO
  EM_ATENDIMENTO
  CONCLUIDO
  CANCELADO
  NAO_COMPARECEU
}

enum OrigemPeca {
  ESTOQUE
  COMPRADA_SEPARADO
  CLIENTE_COMPRA
}

enum StatusItemCliente {
  PENDENTE
  APROVADO
  RECUSADO
}

enum StatusOS {
  ABERTA
  EM_DIAGNOSTICO
  ORCAMENTO_ENVIADO
  APROVADA
  EM_EXECUCAO
  CONCLUIDA
  CANCELADA
}

enum TipoDesconto {
  PERCENTUAL
  VALOR
}

enum StatusDesconto {
  APLICADO
  PENDENTE_APROVACAO
  RECUSADO
}

// Pagamento online: em breve.
enum StatusPagamento {
  PENDENTE
  PAGO_NA_OFICINA
}

enum TipoMovEstoque {
  ENTRADA
  SAIDA
  RESERVA
  LIBERACAO_RESERVA
  AJUSTE
}

enum StatusDespesa {
  A_PAGAR
  PAGO
}

enum SubtipoSalario {
  SALARIO
  VALE
  COMISSAO
  DECIMO_TERCEIRO
  FERIAS
  HORA_EXTRA
  BENEFICIO
}

enum TipoTicket {
  ERRO
  SUGESTAO
  DUVIDA
}

enum StatusTicket {
  ABERTO
  EM_ANALISE
  RESPONDIDO
  RESOLVIDO
}

enum TipoAtor {
  PLATAFORMA
  USUARIO
  CLIENTE
  SISTEMA
  SUPORTE
}

model Plano {
  id            String    @id @default(uuid())
  nome          String    @unique // Autônomo, Oficina, Rede
  precoCentavos Int
  maxMecanicos  Int? // null = ilimitado
  ativo         Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  oficinas      Oficina[]
}

model Oficina {
  id                            String                 @id @default(uuid())
  nome                          String
  documento                     String? // CPF ou CNPJ
  telefone                      String?
  email                         String?
  cep                           String?
  rua                           String?
  numero                        String?
  complemento                   String?
  bairro                        String?
  cidade                        String?
  uf                            String?
  status                        OficinaStatus          @default(TESTE)
  planoId                       String
  plano                         Plano                  @relation(fields: [planoId], references: [id])
  testeAte                      DateTime?
  precoFundadorCentavos         Int? // preço travado para primeiras oficinas
  statusAlteradoEm              DateTime?
  motivoStatus                  String?
  canceladaEm                   DateTime?
  // parâmetros de desconto
  mecanicoPodeDarDesconto       Boolean                @default(false)
  limiteDescontoPercentual      Int? // ex.: 10 = 10%
  limiteDescontoCentavos        Int?
  // agendamento: cliente pode reagendar/cancelar até X horas antes
  antecedenciaCancelamentoHoras Int                    @default(2)
  duracaoPadraoAgendamentoMin   Int                    @default(60) // duração de cada agendamento do cliente
  passoAgendaMin                Int                    @default(30) // de quanto em quanto tempo há horário livre
  janelaAgendamentoDias         Int                    @default(60) // até quantos dias à frente o cliente agenda
  maxAgendamentosPorCliente     Int                    @default(3) // agendamentos futuros feitos pelo cliente
  proximoNumeroOS               Int                    @default(1) // sequencial da OS por oficina
  logoArquivoId                 String? // logo usado no PDF do orçamento
  termosAceitosEm               DateTime?
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt
  deletedAt                     DateTime?
  usuarios                      User[]
  clientes                      ClienteOficina[]
  horarios                      HorarioFuncionamento[]
  convites                      Convite[]
  itensTabelaPreco              ItemTabelaPreco[]
  veiculos                      VeiculoOficina[]
  agendamentos                  Agendamento[]
  ordemServicos                 OrdemServico[]
  estoqueItens                  EstoqueItem[]
  categoriasDespesa             CategoriaDespesa[]
  despesasRecorrentes           DespesaRecorrente[]

  @@index([status])
}

model PlatformAdmin {
  id              String                @id @default(uuid())
  nome            String
  email           String                @unique
  senhaHash       String
  isOwner         Boolean               @default(false)
  permissoes      PermissaoPlataforma[]
  totpSecret      String? // criptografado com AES-256-GCM
  totpAtivadoEm   DateTime? // 2FA só vale depois de confirmado com um código
  totpUltimoPasso Int? // último passo TOTP aceito (impede reusar o mesmo código)
  ativo           Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model User {
  id         String             @id @default(uuid())
  oficinaId  String
  oficina    Oficina            @relation(fields: [oficinaId], references: [id])
  nome       String
  email      String
  telefone   String?
  senhaHash  String
  role       UserRole
  permissoes PermissaoOficina[]
  ativo      Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  agendamentos  Agendamento[]
  ordensServico OrdemServico[]
  despesas      Despesa[]
  recorrentes   DespesaRecorrente[]

  @@unique([oficinaId, email])
  @@index([email])
}

model Cliente {
  id                  String           @id @default(uuid())
  nome                String
  cpf                 String           @unique // só dígitos
  dataNascimento      DateTime?
  rg                  String?
  email               String           @unique
  telefone            String?
  cep                 String?
  rua                 String?
  numero              String?
  complemento         String?
  bairro              String?
  cidade              String?
  uf                  String?
  senhaHash           String
  consentimentoLgpdEm DateTime
  ativo               Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  oficinas            ClienteOficina[]
  veiculos            Veiculo[]
  agendamentos        Agendamento[]
  ordensServico       OrdemServico[]
}

// Vínculo criado pelo convite.
model ClienteOficina {
  clienteId           String
  cliente             Cliente  @relation(fields: [clienteId], references: [id])
  oficinaId           String
  oficina             Oficina  @relation(fields: [oficinaId], references: [id])
  conviteId           String?
  convite             Convite? @relation(fields: [conviteId], references: [id])
  observacoesInternas String? // visível só para a oficina
  createdAt           DateTime @default(now())

  @@id([clienteId, oficinaId])
  @@index([oficinaId])
}

model HorarioFuncionamento {
  id              String   @id @default(uuid())
  oficinaId       String
  oficina         Oficina  @relation(fields: [oficinaId], references: [id])
  diaSemana       Int // 0 = domingo ... 6 = sábado
  abre            String // "08:00"
  fecha           String // "18:00"
  intervaloInicio String?
  intervaloFim    String?
  ativo           Boolean  @default(true) // false = fechado neste dia
  updatedAt       DateTime @updatedAt

  @@unique([oficinaId, diaSemana])
}

model Convite {
  id          String           @id @default(uuid())
  oficinaId   String
  oficina     Oficina          @relation(fields: [oficinaId], references: [id])
  codigo      String           @unique // curto, ex.: ZE7K2P
  individual  Boolean          @default(false)
  nome        String?
  telefone    String?
  expiraEm    DateTime?
  usos        Int              @default(0)
  maxUsos     Int?
  ativo       Boolean          @default(true)
  criadoPorId String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  vinculos    ClienteOficina[]

  @@index([oficinaId, createdAt])
}

// Tabela interna de preços (o cliente nunca vê).
model ItemTabelaPreco {
  id                 String   @id @default(uuid())
  oficinaId          String
  oficina            Oficina  @relation(fields: [oficinaId], references: [id])
  nome               String
  tipo               TipoItem
  precoCentavos      Int
  tempoEstimadoMin   Int?
  estoqueItemId      String? // peça ligada ao estoque (fase 5)
  linkAfiliadoPadrao String?
  ativo              Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([oficinaId, nome])
}

// Veículo é do cliente (conta global). A oficina só vê os vinculados a ela (VeiculoOficina).
model Veiculo {
  id            String           @id @default(uuid())
  clienteId     String
  cliente       Cliente          @relation(fields: [clienteId], references: [id])
  placa         String // maiúsculas, sem hífen
  marca         String?
  modelo        String?
  ano           Int?
  motor         String?
  cor           String?
  combustivel   String?
  chassi        String?
  ativo         Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  oficinas      VeiculoOficina[]
  agendamentos  Agendamento[]
  ordensServico OrdemServico[]

  @@unique([clienteId, placa])
  @@index([placa])
}

// Criado quando a oficina cadastra o veículo ou quando o cliente agenda/abre OS nela.
model VeiculoOficina {
  veiculoId String
  veiculo   Veiculo  @relation(fields: [veiculoId], references: [id])
  oficinaId String
  oficina   Oficina  @relation(fields: [oficinaId], references: [id])
  createdAt DateTime @default(now())

  @@id([veiculoId, oficinaId])
  @@index([oficinaId])
}

model Agendamento {
  id                 String            @id @default(uuid())
  oficinaId          String
  oficina            Oficina           @relation(fields: [oficinaId], references: [id])
  clienteId          String
  cliente            Cliente           @relation(fields: [clienteId], references: [id])
  veiculoId          String
  veiculo            Veiculo           @relation(fields: [veiculoId], references: [id])
  mecanicoId         String?
  mecanico           User?             @relation(fields: [mecanicoId], references: [id])
  tipoServico        String
  inicio             DateTime
  fim                DateTime
  status             StatusAgendamento @default(AGENDADO)
  observacaoCliente  String?
  observacaoOficina  String?
  criadoPorTipo      TipoAtor
  criadoPorId        String
  canceladoEm        DateTime?
  canceladoPorTipo   TipoAtor?
  motivoCancelamento String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  ordemServico       OrdemServico?

  @@index([oficinaId, inicio])
  @@index([mecanicoId, inicio])
  @@index([clienteId, inicio])
}

model OrdemServico {
  id                    String          @id @default(uuid())
  oficinaId             String
  oficina               Oficina         @relation(fields: [oficinaId], references: [id])
  numero                Int // sequencial por oficina
  agendamentoId         String?         @unique
  agendamento           Agendamento?    @relation(fields: [agendamentoId], references: [id])
  clienteId             String
  cliente               Cliente         @relation(fields: [clienteId], references: [id])
  veiculoId             String
  veiculo               Veiculo         @relation(fields: [veiculoId], references: [id])
  mecanicoId            String
  mecanico              User            @relation(fields: [mecanicoId], references: [id])
  status                StatusOS        @default(ABERTA)
  // verificação de entrada — todos opcionais
  kmEntrada             Int?
  combustivel           String?
  estadoVeiculo         String?
  diagnostico           String?
  observacoes           String?
  // desconto no total
  descontoTipo          TipoDesconto?
  descontoValor         Int? // % inteiro ou centavos
  descontoStatus        StatusDesconto?
  descontoPorId         String?
  descontoMotivo        String?
  descontoEm            DateTime?
  descontoDecididoPorId String?
  statusPagamento       StatusPagamento @default(PENDENTE)
  formaPagamento        String?
  pagoEm                DateTime?
  enviadoEm             DateTime?
  aprovadoEm            DateTime?
  iniciadoEm            DateTime?
  concluidoEm           DateTime?
  canceladoEm           DateTime?
  canceladoPorTipo      TipoAtor?
  canceladoPorId        String?
  motivoCancelamento    String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  itens                 ItemOrcamento[]

  @@unique([oficinaId, numero])
  @@index([oficinaId, status])
  @@index([veiculoId, createdAt])
  @@index([mecanicoId, status])
}

model ItemOrcamento {
  id                    String            @id @default(uuid())
  oficinaId             String
  ordemServicoId        String
  ordemServico          OrdemServico      @relation(fields: [ordemServicoId], references: [id])
  tabelaPrecoId         String?
  descricao             String
  tipo                  TipoItem
  origemPeca            OrigemPeca? // só para PECA
  estoqueItemId         String? // quando origem = ESTOQUE
  estoqueItem           EstoqueItem?      @relation(fields: [estoqueItemId], references: [id])
  estoqueReservado      Int               @default(0) // quantidade reservada agora para este item
  estoqueBaixado        Boolean           @default(false) // saída feita na conclusão da OS
  quantidade            Int               @default(1)
  precoUnitarioCentavos Int
  custoUnitarioCentavos Int? // sensível: só MASTER/FINANCEIRO
  linkAfiliado          String?
  descontoTipo          TipoDesconto?
  descontoValor         Int?
  descontoStatus        StatusDesconto?
  descontoPorId         String?
  descontoMotivo        String?
  descontoEm            DateTime?
  descontoDecididoPorId String?
  statusCliente         StatusItemCliente @default(PENDENTE)
  respondidoEm          DateTime?
  // peça que o cliente vai trazer no lugar de um item recusado
  substituiItemId       String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  deletedAt             DateTime?

  @@index([ordemServicoId])
  @@index([oficinaId])
}

// Fotos de OS, anexos de ticket, comprovantes, logo.
model Arquivo {
  id             String    @id @default(uuid())
  oficinaId      String?
  chave          String    @unique // caminho no bucket
  nomeOriginal   String?
  mime           String
  tamanhoBytes   Int
  entidade       String // ORDEM_SERVICO, TICKET, DESPESA, ESTOQUE, OFICINA_LOGO
  entidadeId     String
  enviadoPorTipo TipoAtor
  enviadoPorId   String
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  @@index([entidade, entidadeId])
  @@index([oficinaId])
}

model EstoqueItem {
  id                  String             @id @default(uuid())
  oficinaId           String
  oficina             Oficina            @relation(fields: [oficinaId], references: [id])
  nome                String
  codigo              String?
  marca               String?
  aplicacao           String?
  quantidade          Int                @default(0)
  quantidadeReservada Int                @default(0)
  custoCentavos       Int                @default(0) // sensível: custo médio ponderado
  precoVendaCentavos  Int
  estoqueMinimo       Int                @default(0)
  localizacao         String?
  ativo               Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  movimentos          MovimentoEstoque[]
  itensOrcamento      ItemOrcamento[]

  @@unique([oficinaId, codigo])
  @@index([oficinaId, nome])
}

model MovimentoEstoque {
  id                    String         @id @default(uuid())
  oficinaId             String
  estoqueItemId         String
  estoqueItem           EstoqueItem    @relation(fields: [estoqueItemId], references: [id])
  tipo                  TipoMovEstoque
  quantidade            Int // ENTRADA/SAIDA/RESERVA/LIBERACAO: positiva; AJUSTE: diferença (+/-)
  saldoQuantidade       Int // quantidade depois do movimento
  saldoReservada        Int // reservada depois do movimento
  custoUnitarioCentavos Int?
  fornecedor            String?
  notaFiscal            String?
  ordemServicoId        String?
  itemOrcamentoId       String?
  motivo                String?
  atorTipo              TipoAtor
  usuarioId             String // quem fez (usuário da oficina ou cliente que aprovou)
  createdAt             DateTime       @default(now())

  @@index([estoqueItemId, createdAt])
  @@index([oficinaId, createdAt])
  @@index([ordemServicoId])
}

model CategoriaDespesa {
  id          String              @id @default(uuid())
  oficinaId   String
  oficina     Oficina             @relation(fields: [oficinaId], references: [id])
  nome        String
  ehSalario   Boolean             @default(false) // protegida por VER_SALARIOS
  padrao      Boolean             @default(false)
  ativo       Boolean             @default(true)
  createdAt   DateTime            @default(now())
  despesas    Despesa[]
  recorrentes DespesaRecorrente[]

  @@unique([oficinaId, nome])
}

// Fase 5 cria só o necessário para a despesa automática; o resto vem na fase 6.
model Despesa {
  id                 String             @id @default(uuid())
  oficinaId          String
  data               DateTime
  descricao          String
  valorCentavos      Int
  categoriaId        String
  categoria          CategoriaDespesa   @relation(fields: [categoriaId], references: [id])
  formaPagamento     String?
  status             StatusDespesa
  vencimento         DateTime?
  pagoEm             DateTime?
  recorrenteId       String?
  recorrente         DespesaRecorrente? @relation(fields: [recorrenteId], references: [id])
  competencia        String? // "2026-12": mês gerado pela recorrente
  funcionarioId      String? // pagamento de funcionário
  funcionario        User?              @relation(fields: [funcionarioId], references: [id])
  subtipoSalario     SubtipoSalario?
  movimentoEstoqueId String?            @unique
  criadoPorId        String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  excluidoPorId      String?
  motivoExclusao     String?

  @@unique([recorrenteId, competencia])
  @@index([oficinaId, data])
  @@index([oficinaId, status, vencimento])
}

model DespesaRecorrente {
  id             String           @id @default(uuid())
  oficinaId      String
  oficina        Oficina          @relation(fields: [oficinaId], references: [id])
  descricao      String
  valorCentavos  Int
  categoriaId    String
  categoria      CategoriaDespesa @relation(fields: [categoriaId], references: [id])
  diaVencimento  Int // 1–31; meses curtos usam o último dia
  funcionarioId  String?
  funcionario    User?            @relation(fields: [funcionarioId], references: [id])
  subtipoSalario SubtipoSalario?
  formaPagamento String?
  ativa          Boolean          @default(true)
  criadoPorId    String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  despesas       Despesa[]

  @@index([oficinaId, ativa])
}

model SessaoSuporte {
  id          String    @id @default(uuid())
  adminId     String
  oficinaId   String
  motivo      String
  expiraEm    DateTime
  encerradaEm DateTime?
  createdAt   DateTime  @default(now())

  @@index([adminId, createdAt])
  @@index([oficinaId, createdAt])
}

model AvisoGlobal {
  id          String    @id @default(uuid())
  titulo      String
  mensagem    String
  inicio      DateTime
  fim         DateTime?
  ativo       Boolean   @default(true)
  criadoPorId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ativo, inicio])
}

model Ticket {
  id                 String           @id @default(uuid())
  numero             Int              @unique @default(autoincrement())
  oficinaId          String? // usuários da oficina; null para clientes
  autorTipo          TipoAtor
  autorId            String
  autorNome          String
  tipo               TipoTicket
  titulo             String
  descricao          String
  status             StatusTicket     @default(ABERTO)
  prioridade         Int              @default(0) // 0 normal, 1 alta, 2 urgente
  atribuidoAId       String? // admin responsável
  contexto           Json? // versão do app, aparelho, sistema, tela atual
  primeiraRespostaEm DateTime? // primeira resposta pública do suporte
  resolvidoEm        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  mensagens          TicketMensagem[]

  @@index([status, prioridade, createdAt])
  @@index([autorTipo, autorId, createdAt])
  @@index([oficinaId, createdAt])
}

model TicketMensagem {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  autorTipo TipoAtor
  autorId   String
  autorNome String
  texto     String
  interna   Boolean  @default(false) // nota do suporte: o usuário não vê
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

// Somente INSERT: um trigger no banco bloqueia UPDATE, DELETE e TRUNCATE.
model AuditLog {
  id         String   @id @default(uuid())
  oficinaId  String?
  atorTipo   TipoAtor
  atorId     String?
  atorNome   String?
  acao       String // ex.: ORCAMENTO_DESCONTO_APLICADO
  entidade   String
  entidadeId String?
  antes      Json?
  depois     Json?
  motivo     String?
  ip         String?
  userAgent  String?
  origem     String? // APP_ANDROID, APP_IOS, DESKTOP, WEB
  createdAt  DateTime @default(now())

  @@index([oficinaId, createdAt])
  @@index([entidade, entidadeId])
  @@index([atorTipo, atorId, createdAt])
  @@index([acao, createdAt])
}

// Refresh token opaco; só o HMAC fica salvo. Rotativo: cada uso gera um novo.
model RefreshToken {
  id             String    @id @default(uuid())
  atorTipo       TipoAtor
  atorId         String
  hash           String    @unique
  expiraEm       DateTime
  revogadoEm     DateTime?
  substituidoPor String?
  ip             String?
  userAgent      String?
  createdAt      DateTime  @default(now())

  @@index([atorTipo, atorId])
}
