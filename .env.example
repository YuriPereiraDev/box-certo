# Copie para .env (na raiz do repositório) e preencha.
# O .env é lido pelo docker compose e pela API (apps/api).

NODE_ENV=development
PORT=3000
TZ=America/Sao_Paulo

# Banco
POSTGRES_USER=boxcerto
POSTGRES_PASSWORD=boxcerto
POSTGRES_DB=boxcerto
DATABASE_URL=postgresql://boxcerto:boxcerto@localhost:5432/boxcerto

# Segurança (gere valores aleatórios longos)
JWT_ACCESS_SECRET=troque
JWT_REFRESH_SECRET=troque
# 32 bytes em base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=chave-32-bytes-base64

# Arquivos (SeaweedFS local / S3 / R2)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=box-certo
S3_ACCESS_KEY=boxcerto
S3_SECRET_KEY=boxcerto123

# E-mail (Mailpit em dev; painel em http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025

APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Super admin dono (criado só pelo seed)
OWNER_NAME=Yuri Pereira
OWNER_EMAIL=
OWNER_PASSWORD=

# Limites de requisição por IP por minuto
RATE_LIMIT_LOGIN=5
RATE_LIMIT_GERAL=300

# Senha dos usuários e do cliente da oficina de exemplo do seed (só dev)
SEED_SENHA_USUARIOS=
